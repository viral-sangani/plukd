{
  "name": "plukd",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently \"pnpm --filter @plukd/backend dev\" \"pnpm --filter @plukd/frontend dev\"",
    "dev:backend": "pnpm --filter @plukd/backend dev",
    "dev:frontend": "pnpm --filter @plukd/frontend dev",
    "build": "pnpm -r build",
    "build:shared": "pnpm --filter @plukd/shared build",
    "build:backend": "pnpm --filter @plukd/backend build",
    "build:frontend": "pnpm --filter @plukd/frontend build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean",
    "db:push": "npx supabase db push"
  },
  "devDependencies": {
    "@types/node": "^20.19.27",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.0"
  }
}
