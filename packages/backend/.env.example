# Server Configuration
PORT=3000
NODE_ENV=development  # development | production
CORS_ORIGIN=http://localhost:3001  # Production: https://plukd.xyz

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# External Services
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=  # Generate with: openssl rand -hex 32
GOPHER_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Redis (for BullMQ)
REDIS_URL=redis://localhost:6379

# App URL (required for Telegram webhook registration in production)
APP_URL=  # Production: https://api.plukd.xyz
